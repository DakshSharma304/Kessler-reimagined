# Process environment values; this example is NOT automatically loaded.
KESSLER_ENV=development
KESSLER_HOST=127.0.0.1
KESSLER_PORT=8000
KESSLER_CACHE_DIR=.cache/kessler
KESSLER_DATA_DIR=data
KESSLER_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional OMM filenames relative to DATA_DIR, or absolute paths.
KESSLER_CATALOG_FILES=[]
# Optional documented SATCAT CSV. Unset means the public source.
# KESSLER_METADATA_FILE=satcat.csv
